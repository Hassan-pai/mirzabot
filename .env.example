# ============================================================================
#  MirzaBot on Railway – environment variables
#  Never commit real values. Set them in Railway → Service → Variables.
#  SPDX-License-Identifier: AGPL-3.0-or-later
# ============================================================================

# --- الزامی --------------------------------------------------------------
BOT_TOKEN=123456:AA...                # توکن ربات از @BotFather
ADMIN_CHAT_ID=123456789               # آیدی عددی ادمین (@userinfobot)

# --- هویت / دامنه ---------------------------------------------------------
BOT_USERNAME=                         # بدون @ ؛ خالی بگذار تا از getMe خوانده شود
DOMAIN=                               # خالی = از RAILWAY_PUBLIC_DOMAIN خودکار
TZ=Asia/Tehran

# --- دیتابیس (روش پیشنهادی: فقط همین یکی) --------------------------------
DB_URL=${{MySQL.MYSQL_URL}}           # رفرنس داخلی سرویس MySQL ریلوی (پورت 3306)
DB_NAME=mirzabot                      # اگر در DB_URL نام دیگری بود، همان اولویت دارد

# --- دیتابیس (روش دستی؛ جای DB_URL) -------------------------------------
# DB_HOST=mysql.railway.internal
# DB_PORT=3306
# DB_USER=root
# DB_PASS=...

# --- کاربر کم‌دسترسی (مهم! باگ information_schema در table.php) -----------
DB_LEAST_PRIVILEGE=true               # ساخت کاربر مخصوص همین دیتابیس
DB_APP_USER=mirza_app
DB_APP_PASS=                          # خالی = رمز تصادفی در هر بوت
DB_WAIT_ATTEMPTS=30                   # تعداد تلاش برای آماده‌شدن MySQL
DB_WAIT_DELAY=3

# --- مهاجرت جداول --------------------------------------------------------
RUN_MIGRATIONS=true                   # اجرای table.php در هر بوت (idempotent)
STRICT_MIGRATIONS=false               # true = اگر جدول اصلی ساخته نشد، بوت متوقف شود
SHOW_PANEL_CREDENTIALS=true           # چاپ یوزر/پس پنل وب در لاگ اولین دیپلوی

# --- وب‌هوک تلگرام -------------------------------------------------------
SET_WEBHOOK=true
WEBHOOK_DELAY=8
WEBHOOK_RETRIES=8
WEBHOOK_MAX_CONNECTIONS=40
WEBHOOK_DROP_PENDING=false
WEBHOOK_SECRET=                       # اختیاری (secret_token تلگرام)

# --- کران‌جاب‌ها ---------------------------------------------------------
CRON_MODE=runner                      # runner | cron | off
CRON_JOB_TIMEOUT=300
CRON_DISABLE=                         # مثال: backupbot.php,lottery.php
CRON_OVERRIDES=                       # مثال: {"plisio.php":60,"backupbot.php":"at:04:30"}

# --- متفرقه --------------------------------------------------------------
PORT=8080                             # ریلوی خودش مقدار می‌دهد؛ دست نزن
REQUEST_EXEC_TIMEOUT=                 # خالی = null (پیش‌فرض خود ربات)
